# Shared secret for the web UI + MCP endpoints.
# Auth is disabled if unset (local dev only!).
# Clients send it as: Authorization: Bearer <secret>  (or X-API-Key, or ?token= for browsers)
AGENT_BUS_AUTH_TOKEN=change-me

# SQLite database location.
# Local default: ~/.agent_bus/agent_bus.sqlite
# Railway: use the persistent volume, e.g. /data/agent_bus.sqlite
#AGENT_BUS_DB=/data/agent_bus.sqlite

# Server transport for bare `agent-bus` (stdio | streamable-http | sse).
# Defaults to streamable-http when PORT is set, else stdio.
# `agent-bus serve` always runs Web UI + /mcp + /sse.
#AGENT_BUS_TRANSPORT=streamable-http
#AGENT_BUS_HOST=0.0.0.0

# Semantic search downloads an ONNX model + ONNX Runtime on first use.
# Set to 0 to skip embeddings (FTS search still works, smaller/faster boot).
#AGENT_BUS_EMBEDDINGS_AUTOINDEX=1

# Cap on sync() page size (default 20)
#AGENT_BUS_MAX_SYNC_ITEMS=20
