# --- Authentication (HTTP deployment, `agent-bus serve`) ----------------------
# All four are REQUIRED for `serve`; it refuses to start without them.
# Create an Okta OIDC Web app (Auth Code + PKCE), redirect URI
# <AGENT_BUS_PUBLIC_URL>/auth/callback, and configure the groups claim at
# userinfo (see docs/how-to/okta-auth.md).
AGENT_BUS_OKTA_ISSUER=https://<your-okta-domain>/oauth2/<server-id>
AGENT_BUS_OKTA_CLIENT_ID=change-me
AGENT_BUS_OKTA_CLIENT_SECRET=change-me
AGENT_BUS_PUBLIC_URL=https://your-deployment.example.com

# Okta group that grants admin (browser sessions only, 24h TTL).
#AGENT_BUS_ADMIN_GROUP=Permission - agent-bus - Admin
# Token lifetimes: MCP tokens AGENT_BUS_TOKEN_TTL_DAYS (default 90);
# browser tokens are always 24h.
#AGENT_BUS_TOKEN_TTL_DAYS=90

# --- Storage -------------------------------------------------------------------
# SQLite database location.
# Local default: ~/.agent_bus/agent_bus.sqlite
# Railway: use the persistent volume, e.g. /data/agent_bus.sqlite
#AGENT_BUS_DB=/data/agent_bus.sqlite
# Token store (default: tokens.sqlite next to AGENT_BUS_DB; snapshot together).
#AGENT_BUS_TOKENS_DB=/data/tokens.sqlite

# Server transport for bare `agent-bus` (stdio only over HTTP now: standalone
# HTTP MCP is refused — use `agent-bus serve`). Defaults to stdio unless PORT is set.
#AGENT_BUS_TRANSPORT=stdio
#AGENT_BUS_HOST=0.0.0.0

# Semantic search downloads an ONNX model + ONNX Runtime on first use.
# Set to 0 to skip embeddings (FTS search still works, smaller/faster boot).
#AGENT_BUS_EMBEDDINGS_AUTOINDEX=1

# Cap on sync() page size (default 20)
#AGENT_BUS_MAX_SYNC_ITEMS=20
